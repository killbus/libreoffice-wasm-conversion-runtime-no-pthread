+bool FreeTypeTextRenderImpl::RemoveTempDevFonts(const std::vector<OUString>& rFileURLs)
+{
+    psp::PrintFontManager& rMgr = psp::PrintFontManager::get();
+    std::vector<psp::fontID> aFontIds;
+    for (const OUString& rFileURL : rFileURLs)
+    {
+        std::vector<psp::fontID> aFileFontIds = rMgr.findFontFileIDs(rFileURL);
+        aFontIds.insert(aFontIds.end(), aFileFontIds.begin(), aFileFontIds.end());
+    }
+
+    if (!rMgr.removeFontFiles(rFileURLs))
+        return false;
+
+    FreetypeManager& rFreetypeManager = FreetypeManager::get();
+    for (auto const& nFontId : aFontIds)
+        rFreetypeManager.RemoveFontFile(nFontId);
+    return true;
+}
+
+bool FreeTypeTextRenderImpl::ReplaceTempDevFonts(
+    const std::vector<OUString>& rRemovedURLs, const std::vector<OUString>& rAddedURLs)
+{
+    psp::PrintFontManager& rMgr = psp::PrintFontManager::get();
+    std::vector<psp::fontID> aRemovedFontIds;
+    for (const OUString& rFileURL : rRemovedURLs)
+    {
+        std::vector<psp::fontID> aFileFontIds = rMgr.findFontFileIDs(rFileURL);
+        aRemovedFontIds.insert(aRemovedFontIds.end(), aFileFontIds.begin(),
+                               aFileFontIds.end());
+    }
+
+    if (!rRemovedURLs.empty() && !rMgr.removeFontFiles(rRemovedURLs))
+        return false;
+
+    FreetypeManager& rFreetypeManager = FreetypeManager::get();
+    for (auto const& nFontId : aRemovedFontIds)
+        rFreetypeManager.RemoveFontFile(nFontId);
+
+    for (const OUString& rFileURL : rAddedURLs)
+    {
+        if (!AddTempDevFont(nullptr, rFileURL, OUString()))
+            return false;
+    }
     return true;
 }
 
