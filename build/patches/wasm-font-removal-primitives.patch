+bool PrintFontManager::removeFontFiles(const std::vector<OUString>& rFileUrls)
+{
+    rtl_TextEncoding aEncoding = osl_getThreadTextEncoding();
+    std::vector<OString> aFontconfigFiles;
+    aFontconfigFiles.reserve(rFileUrls.size());
+    for (const OUString& rFileUrl : rFileUrls)
+    {
+        INetURLObject aPath(rFileUrl);
+        aFontconfigFiles.push_back(OUStringToOString(aPath.GetFull(), aEncoding));
+    }
+    if (!removeFontconfigFiles(aFontconfigFiles))
+        return false;
+
+    for (const OUString& rFileUrl : rFileUrls)
+    {
+        INetURLObject aPath(rFileUrl);
+        OString aName(OUStringToOString(
+            aPath.GetLastName(INetURLObject::DecodeMechanism::WithCharset, aEncoding), aEncoding));
+        for (auto nFontID : findFontFileIDs(rFileUrl))
+        {
+            m_aFonts.erase(nFontID);
+            m_aFontFileToFontID[aName].erase(nFontID);
+        }
+        if (m_aFontFileToFontID[aName].empty())
+            m_aFontFileToFontID.erase(aName);
+    }
+    return true;
+}
