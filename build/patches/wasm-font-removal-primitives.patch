+
+bool OutputDevice::ReplaceTempDevFonts(const std::vector<OUString>& rRemovedURLs,
+                                       const std::vector<OUString>& rAddedURLs)
+{
+    if (!mpGraphics && !AcquireGraphics())
+        return rAddedURLs.empty();
+    assert(mpGraphics);
+
+    ImplInvalidateAllFontData(true);
+    mpGraphics->ClearDevFontCache();
+    const bool bSuccess = mpGraphics->ReplaceTempDevFonts(rRemovedURLs, rAddedURLs);
+    ImplRefreshAllFontData(true);
+    return bSuccess;
+}
