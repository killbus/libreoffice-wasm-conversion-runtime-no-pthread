+bool PrintFontManager::removeFontconfigFiles(const std::vector<OString>& rFiles)
+{
+    FcConfig* pConfig = FcConfigGetCurrent();
+    FcFontSet* pOrig = FcConfigGetFonts(pConfig, FcSetApplication);
+    if (!pOrig)
+        return false;
+
+    const std::set<OString> aRemoveList(rFiles.begin(), rFiles.end());
+    std::set<OString> aOriginalList;
+    std::set<OString> aRetainedList;
+
+    for (int i = 0; i < pOrig->nfont; ++i)
+    {
+        FcChar8* pFile = nullptr;
+        if (FcPatternGetString(pOrig->fonts[i], FC_FILE, 0, &pFile) != FcResultMatch || !pFile)
+            return false;
+        OString aFile(reinterpret_cast<char*>(pFile));
+        aOriginalList.emplace(aFile);
+        if (aRemoveList.find(aFile) == aRemoveList.end())
+            aRetainedList.emplace(std::move(aFile));
+    }
+
+    FcConfigAppFontClear(pConfig);
+
+    bool bSuccess = true;
+    for (const OString& rFilename : aRetainedList)
+    {
+        if (FcConfigAppFontAddFile(
+                pConfig, reinterpret_cast<FcChar8 const*>(rFilename.getStr())) != FcTrue)
+        {
+            bSuccess = false;
+            break;
+        }
+    }
+
+    if (!bSuccess)
+    {
+        FcConfigAppFontClear(pConfig);
+        for (const OString& rFilename : aOriginalList)
+        {
+            if (FcConfigAppFontAddFile(
+                    pConfig, reinterpret_cast<FcChar8 const*>(rFilename.getStr())) != FcTrue)
+            {
+                break;
+            }
+        }
+    }
+
+    FontCfgWrapper& rWrapper = FontCfgWrapper::get();
+    rWrapper.clear();
+    rWrapper.getFontSet();
+    return bSuccess;
+}
