+sal_Int32 PrintFontManager::countFontconfigApplicationFontsForPathPrefix(
+    const OString& rPathPrefix)
+{
+    FcConfig* pConfig = FcConfigGetCurrent();
+    if (!pConfig)
+        return -1;
+
+    FcFontSet* pFonts = FcConfigGetFonts(pConfig, FcSetApplication);
+    if (!pFonts)
+        return -1;
+
+    sal_Int32 nCount = 0;
+    for (int i = 0; i < pFonts->nfont; ++i)
+    {
+        FcChar8* pFile = nullptr;
+        if (FcPatternGetString(pFonts->fonts[i], FC_FILE, 0, &pFile) == FcResultMatch && pFile
+            && OString(reinterpret_cast<char*>(pFile)).startsWith(rPathPrefix))
+        {
+            ++nCount;
+        }
+    }
+    return nCount;
+}
