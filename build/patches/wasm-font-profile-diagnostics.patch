+bool OutputDevice::GetTempDevFontDiagnostics(
+    const OString& rPathPrefix, sal_Int32& rPrintFontManagerRecords,
+    sal_Int32& rFontconfigApplicationPatterns, sal_Int32& rFreetypeFontInfoRecords,
+    sal_Int32& rFreetypeFontFileRecords) const
+{
+#ifdef EMSCRIPTEN
+    psp::PrintFontManager& rPrintFontManager = psp::PrintFontManager::get();
+    FreetypeManager& rFreetypeManager = FreetypeManager::get();
+    rPrintFontManagerRecords
+        = rPrintFontManager.countFontRecordsForPathPrefix(rPathPrefix);
+    rFontconfigApplicationPatterns
+        = psp::PrintFontManager::countFontconfigApplicationFontsForPathPrefix(rPathPrefix);
+    if (rFontconfigApplicationPatterns < 0)
+        return false;
+    rFreetypeFontInfoRecords
+        = rFreetypeManager.CountFontInfoRecordsForPathPrefix(rPathPrefix);
+    rFreetypeFontFileRecords
+        = rFreetypeManager.CountFontFileRecordsForPathPrefix(rPathPrefix);
+    return true;
+#else
+    (void)rPathPrefix;
+    rPrintFontManagerRecords = -1;
+    rFontconfigApplicationPatterns = -1;
+    rFreetypeFontInfoRecords = -1;
+    rFreetypeFontFileRecords = -1;
+    return false;
+#endif
+}
